[
  {
    "id": "g_gender",
    "title": "Masculine & feminine nouns (o / a)",
    "order": 1,
    "tier": 1,
    "summary": "Every noun is masculine or feminine; the article and adjectives follow it.",
    "explain": "Every Spanish noun has a gender. It matters because **the words around it change** to match.\n\n| | masculine | feminine |\n|---|---|---|\n| the | **el** carro | **la** casa |\n| a | **un** boleto | **una** cuenta |\n\n- Most nouns ending in **-o** are masculine: *el taco, el boleto*.\n- Most nouns ending in **-a** are feminine: *la casa, la cuenta*.\n- Learn the exceptions as you meet them: *el día, la mano*.\n\nTip: always learn a noun **with its article**: not *casa* but *la casa*.",
    "rules": [
      {
        "rule": "Nouns ending in -o are usually masculine.",
        "examples": [
          "el libro",
          "el vaso"
        ],
        "exceptions": [
          "la mano",
          "la foto",
          "la radio"
        ]
      },
      {
        "rule": "Nouns ending in -a are usually feminine.",
        "examples": [
          "la casa",
          "la mesa"
        ],
        "exceptions": [
          "el día",
          "el mapa",
          "el problema"
        ]
      }
    ],
    "drills": [
      {
        "type": "choice",
        "q": "___ casa",
        "answer": "la",
        "why": "casa ends in -a → feminine",
        "options": [
          "el",
          "la"
        ]
      },
      {
        "type": "choice",
        "q": "___ carro",
        "answer": "el",
        "why": "carro ends in -o → masculine",
        "options": [
          "el",
          "la"
        ]
      },
      {
        "type": "choice",
        "q": "___ día",
        "answer": "el",
        "why": "día is an exception: masculine",
        "options": [
          "el",
          "la"
        ]
      },
      {
        "type": "choice",
        "q": "___ mano",
        "answer": "la",
        "why": "mano is an exception: feminine",
        "options": [
          "el",
          "la"
        ]
      },
      {
        "type": "choice",
        "q": "___ cuenta",
        "answer": "una",
        "why": "cuenta is feminine → una",
        "options": [
          "un",
          "una"
        ]
      },
      {
        "type": "choice",
        "q": "___ boleto",
        "answer": "un",
        "why": "boleto is masculine → un",
        "options": [
          "un",
          "una"
        ]
      },
      {
        "type": "fill",
        "q": "___ calle (the)",
        "answer": "la",
        "why": "calle is feminine"
      },
      {
        "type": "fill",
        "q": "___ hotel (the)",
        "answer": "el",
        "why": "hotel is masculine"
      },
      {
        "type": "translate",
        "q": "the house",
        "answer": "la casa",
        "why": "casa is feminine"
      },
      {
        "type": "translate",
        "q": "a ticket",
        "answer": "un boleto",
        "why": "boleto is masculine"
      },
