  {
    "id": "g_agreement",
    "title": "Adjectives agree (bonito / bonita)",
    "order": 2,
    "tier": 1,
    "summary": "Adjectives copy the noun's gender and number.",
    "explain": "Adjectives usually go **after** the noun and **match it**:\n\n- *el carro rojo* → *la casa roja*\n- *los carros rojos* → *las casas rojas*\n\nAdjectives ending in **-e** or a consonant don't change for gender: *un café grande, una casa grande*.",
    "rules": [
      {
        "rule": "-o adjectives change to -a for feminine nouns.",
        "examples": [
          "la casa bonita",
          "el carro bonito"
        ],
        "exceptions": []
      },
      {
        "rule": "Add -s (or -es) for plural.",
        "examples": [
          "las casas bonitas",
          "los hoteles grandes"
        ],
        "exceptions": []
      }
    ],
    "drills": [
